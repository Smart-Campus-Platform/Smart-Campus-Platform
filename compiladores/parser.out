    (5) consultar -> . CONSULTAR RESERVAS
    (6) consultar -> . CONSULTAR RESERVAS ATIVAS
    (7) consultar -> . CONSULTAR RESERVAS CANCELADAS
    (11) cancelar -> . CANCELAR RESERVA recurso NUMBER

    RESERVAR        shift and go to state 5
    CONSULTAR       shift and go to state 6
    CANCELAR        shift and go to state 7

    programa                       shift and go to state 1
    reservar                       shift and go to state 2
    consultar                      shift and go to state 3
    cancelar                       shift and go to state 4

state 1

    (0) S' -> programa .



state 2

