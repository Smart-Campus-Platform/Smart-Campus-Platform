Parsing method: LALR

state 0

    (0) S' -> . programa
    (1) programa -> . reservar
    (2) programa -> . consultar
    (3) reservar -> . RESERVAR recurso STRING DATA DATE HORA_INICIO TIME HORA_FIM TIME
    (4) consultar -> . CONSULTAR RESERVAS
    (5) consultar -> . CONSULTAR RESERVAS ATIVAS
    (6) consultar -> . CONSULTAR RESERVAS CANCELADAS

    RESERVAR        shift and go to state 4
    CONSULTAR       shift and go to state 5

    programa                       shift and go to state 1
    reservar                       shift and go to state 2
    consultar                      shift and go to state 3

state 1

    (0) S' -> programa .



state 2

    (1) programa -> reservar .

    $end            reduce using rule 1 (programa -> reservar .)


state 3

    (2) programa -> consultar .

    $end            reduce using rule 2 (programa -> consultar .)


state 4

    (3) reservar -> RESERVAR . recurso STRING DATA DATE HORA_INICIO TIME HORA_FIM TIME
    (7) recurso -> . SALA
    (8) recurso -> . LABORATORIO
    (9) recurso -> . EQUIPAMENTO

    SALA            shift and go to state 7
    LABORATORIO     shift and go to state 8
    EQUIPAMENTO     shift and go to state 9

    recurso                        shift and go to state 6

state 5

    (4) consultar -> CONSULTAR . RESERVAS
    (5) consultar -> CONSULTAR . RESERVAS ATIVAS
    (6) consultar -> CONSULTAR . RESERVAS CANCELADAS

    RESERVAS        shift and go to state 10


state 6

    (3) reservar -> RESERVAR recurso . STRING DATA DATE HORA_INICIO TIME HORA_FIM TIME

    STRING          shift and go to state 11


state 7

    (7) recurso -> SALA .

    STRING          reduce using rule 7 (recurso -> SALA .)


state 8

    (8) recurso -> LABORATORIO .

    STRING          reduce using rule 8 (recurso -> LABORATORIO .)


state 9

    (9) recurso -> EQUIPAMENTO .

    STRING          reduce using rule 9 (recurso -> EQUIPAMENTO .)


state 10

    (4) consultar -> CONSULTAR RESERVAS .
    (5) consultar -> CONSULTAR RESERVAS . ATIVAS
    (6) consultar -> CONSULTAR RESERVAS . CANCELADAS

    $end            reduce using rule 4 (consultar -> CONSULTAR RESERVAS .)
    ATIVAS          shift and go to state 12
    CANCELADAS      shift and go to state 13


state 11

    (3) reservar -> RESERVAR recurso STRING . DATA DATE HORA_INICIO TIME HORA_FIM TIME

    DATA            shift and go to state 14


state 12

    (5) consultar -> CONSULTAR RESERVAS ATIVAS .

    $end            reduce using rule 5 (consultar -> CONSULTAR RESERVAS ATIVAS .)


state 13

    (6) consultar -> CONSULTAR RESERVAS CANCELADAS .

    $end            reduce using rule 6 (consultar -> CONSULTAR RESERVAS CANCELADAS .)


state 14

    (3) reservar -> RESERVAR recurso STRING DATA . DATE HORA_INICIO TIME HORA_FIM TIME

    DATE            shift and go to state 15


state 15

    (3) reservar -> RESERVAR recurso STRING DATA DATE . HORA_INICIO TIME HORA_FIM TIME

    HORA_INICIO     shift and go to state 16


state 16

    (3) reservar -> RESERVAR recurso STRING DATA DATE HORA_INICIO . TIME HORA_FIM TIME

    TIME            shift and go to state 17


state 17

    (3) reservar -> RESERVAR recurso STRING DATA DATE HORA_INICIO TIME . HORA_FIM TIME

    HORA_FIM        shift and go to state 18


state 18

    (3) reservar -> RESERVAR recurso STRING DATA DATE HORA_INICIO TIME HORA_FIM . TIME

    TIME            shift and go to state 19


state 19

    (3) reservar -> RESERVAR recurso STRING DATA DATE HORA_INICIO TIME HORA_FIM TIME .

    $end            reduce using rule 3 (reservar -> RESERVAR recurso STRING DATA DATE HORA_INICIO TIME HORA_FIM TIME .)

